---
// 開催概要セクション（p-outline）
import Heading from "../Heading.astro";
---

<section id="outline" class="p-outline">
  <div class="p-outline__inner l-inner">
    <Heading title="Outline" subtitle="開催概要" />
    <div class="p-outline__content">
      <p class="p-outline__free">
        <span class="u-pink">参</span><span class="u-violet">加</span><span class="u-blue">無</span><span
          class="u-yellow">料</span
        >
      </p>
      <dl class="p-outline__detail">
        <div class="p-outline__detail-item">
          <dt class="p-outline__dt">開催日時</dt>
          <dd class="p-outline__dd">
            <p class="p-outline__dd-text">2026.11.01 SUN</p>
            <p class="p-outline__dd-text">10:00-17:00</p>
          </dd>
        </div>
        <div class="p-outline__detail-item">
          <dt class="p-outline__dt p-outline__dt--wide">会場</dt>
          <dd class="p-outline__dd">
            <p class="p-outline__venue">
              <a href="https://www.odette.or.jp/plaza-odette/" target="_blank" rel="noopener noreferrer"
                >盛岡市観光文化交流センター<span class="p-outline__venue-name"
                  >プラザおでって<svg
                    class="p-outline__icon"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    role="img"
                    aria-label="新しいタブで開きます"
                    ><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><path d="M15 3h6v6"
                    ></path><path d="M10 14 21 3"></path></svg
                  ></span
                ></a
              >
            </p>
            <p class="p-outline__address">
              <a href="https://maps.app.goo.gl/mMRaSddfKpTiTgSH9" target="_blank" rel="noopener noreferrer"
                >岩手県盛岡市中ノ橋通1丁目1-10<span class="p-outline__map"
                  ><svg
                    class="p-outline__map-icon"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                    ><path
                      d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"
                    ></path></svg
                  >Mapで見る</span
                ></a
              >
            </p>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>
