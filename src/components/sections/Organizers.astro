---
// 主催・後援セクション（p-organizer）
import Heading from "../Heading.astro";
---

<section class="p-organizer">
  <div class="p-organizer__inner l-inner">
    <div class="p-organizer__group">
      <Heading title="Organized by" subtitle="主催" />
      <ul class="p-organizer__list">
        <li class="p-organizer__item">DojoCon Japan 実行委員会</li>
        <li class="p-organizer__item">一般社団法人 CoderDojo Japan</li>
      </ul>
    </div>

    <div class="p-organizer__group">
      <Heading title="Supported by" subtitle="後援" />
      <ul class="p-organizer__list p-organizer__list--support">
        <li class="p-organizer__item p-organizer__item--support">
          <img src="/images/support/raspberry-pi.svg" alt="Raspberry Pi財団" width="100" height="30" />
        </li>
        <li class="p-organizer__item p-organizer__item--support">
          <img
            class="p-organizer__item-icon p-organizer__item-icon--iwate"
            src="/images/support/iwate.webp"
            alt="岩手県章"
            width="28"
            height="31"
          />
          岩手県
        </li>
        <li class="p-organizer__item p-organizer__item--support">
          <img
            class="p-organizer__item-icon p-organizer__item-icon--morioka"
            src="/images/support/morioka.png"
            alt="盛岡市章"
            width="30"
            height="30"
          />
          岩手県盛岡市
        </li>
        <li class="p-organizer__item p-organizer__item--support">
          <img
            class="p-organizer__item-icon p-organizer__item-icon--takizawa"
            src="/images/support/takizawa.png"
            alt="滝沢市章"
            width="28"
            height="25"
          />
          岩手県滝沢市
        </li>
        <li class="p-organizer__item p-organizer__item--support">
          <img src="/images/support/iisa.svg" alt="岩手県情報サービス産業協会" width="180" height="25" />
        </li>
      </ul>
    </div>
  </div>
</section>
