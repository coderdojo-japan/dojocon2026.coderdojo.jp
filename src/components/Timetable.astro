---
// タイムテーブル（p-timetable）。縦軸=時間 / 横軸=場所（スロット）。
// 中身は CSS Grid で組んでいる。JavaScript を使うのは現在時刻ラインだけ。
//
// グリッドの行は「ヘッダー行 1 行 + stepMinutes 刻みの行 × totalRows」。
// そのため src/lib/timetable.ts が返す行番号には HEADER_ROWS を足してから使う。
//
// 色は src/data/timetable.ts の colorBy で、場所（slot）・種別（type）・テーマ（theme）から選ぶ。
// 列の色は見出し・背景・タブに、コマの色はコマに --tt-slot-color として流し込み、
// 配色は SCSS 側で組み立てる。場所以外で色分けするときは、表の上に凡例を出す。
//
// コマが1つも入っていない場所は列ごと出さない。会場のレイアウトが先に決まって
// セッションが後から埋まる進み方でも、空の列が並ばずに済む。
//
// 画面が狭いときは全部の場所を横に並べず、場所を1つずつ切り替えて見せる。
// 切り替えは name を共有したラジオボタンで行い、CSS の :checked で表示を差し替える
// （そのためラジオは .p-timetable__tabs と .p-timetable__scroll より前に置くこと）。
// 各要素の data-col は「何列目のものか」を表し、CSS が表示/非表示の判定に使う。
//
// 見出しは置かない。どこに置くかはページ側（/timetable なら ArchiveLayout）の担当。
import { getTimetable } from "../lib/timetable";
import { timetableConfig } from "../data/timetable";
import { site } from "../data/site";

/** ヘッダー（場所名）が占める行数 */
const HEADER_ROWS = 1;

const { columns: allColumns, legend, ticks, totalRows, rowsPerTick, hourRows, isEmpty } = await getTimetable();

// コマが入っていない場所は列ごと省く
const columns = allColumns.filter((column) => column.entries.length > 0);

// 寸法の既定値は SCSS 側に持たせ、データから決まる値だけカスタムプロパティで渡す
const gridStyle = [`--tt-cols:${columns.length}`, `--tt-rows:${totalRows}`, `--tt-rows-per-tick:${rowsPerTick}`].join(
  ";",
);

// 現在時刻ラインの位置決めに使う値。描画はブラウザ側（開催当日のみ）
const nowData = {
  "data-date": site.event.date,
  "data-start": timetableConfig.startTime,
  "data-end": timetableConfig.endTime,
  "data-step": String(timetableConfig.stepMinutes),
  "data-header-rows": String(HEADER_ROWS),
};
---

<div class="p-timetable">
  {
    isEmpty ? (
      <p class="p-timetable__empty">タイムテーブルは準備中です。決まり次第お知らせします。</p>
    ) : (
      <>
        {/* 場所の切り替え（狭い画面でのみ使う）。見た目はラベル側に持たせる */}
        {columns.map((column, index) => (
          <input
            class="p-timetable__radio"
            type="radio"
            name="timetable-slot"
            id={`timetable-slot-${column.slot.id}`}
            checked={index === 0}
          />
        ))}

        <div class="p-timetable__tabs" role="group" aria-label="表示する場所を選ぶ">
          {columns.map((column) => (
            <label
              class="p-timetable__tab"
              for={`timetable-slot-${column.slot.id}`}
              style={`--tt-slot-color:${column.color}`}
            >
              {column.slot.name}
            </label>
          ))}
        </div>

        {/* 色の凡例（種別・テーマで色分けするときだけ） */}
        {legend.length > 0 && (
          <ul class="p-timetable__legend" aria-label="色の凡例">
            {legend.map((item) => (
              <li class="p-timetable__legend-item" style={`--tt-slot-color:${item.color}`}>
                {item.label}
              </li>
            ))}
          </ul>
        )}

        <p class="p-timetable__hint" aria-hidden="true">
          表が入りきらないときは横にスクロールできます →
        </p>

        <div class="p-timetable__scroll">
          <div class="p-timetable__grid" style={gridStyle}>
            {/* 左の時間軸の下地。横スクロール時にコマが目盛りへ重なるのを防ぐ */}
            <div class="p-timetable__axis" style={`grid-row:1 / -1`} aria-hidden="true" />

            {/* 場所名（横軸の見出し） */}
            {columns.map((column, index) => (
              <div
                class="p-timetable__slot"
                data-col={index + 1}
                style={`grid-column:${index + 2};--tt-slot-color:${column.color}`}
              >
                <span class="p-timetable__slot-name">{column.slot.name}</span>
                {column.slot.note && <span class="p-timetable__slot-note">{column.slot.note}</span>}
              </div>
            ))}

            {/* 各列の背景と30分ごとの横罫線。コマより先に置いて背面にする */}
            {columns.map((column, index) => (
              <div
                class="p-timetable__lane"
                data-col={index + 1}
                style={`grid-column:${index + 2};grid-row:${HEADER_ROWS + 1} / -1;--tt-slot-color:${column.color}`}
                aria-hidden="true"
              />
            ))}

            {/* 毎時00分の区切り線。レーンより後・コマより前に置いて、間にはさむ */}
            {hourRows.map((row) => (
              <div class="p-timetable__hourline" style={`grid-row:${row + HEADER_ROWS}`} aria-hidden="true" />
            ))}

            {/* 左の時間軸の目盛り */}
            {ticks.map((tick) => (
              <div
                class:list={["p-timetable__tick", tick.isHour && "p-timetable__tick--hour"]}
                style={`grid-row:${tick.row + HEADER_ROWS}`}
                aria-hidden="true"
              >
                <span class="p-timetable__tick-label">{tick.label}</span>
              </div>
            ))}

            {/* コマ本体 */}
            {columns.map((column, index) =>
              column.entries.map((entry) => (
                <a
                  class={`p-timetable__entry p-timetable__entry--${entry.kind}`}
                  data-col={index + 1}
                  href={entry.href}
                  style={`grid-column:${index + 2};grid-row:${entry.rowStart + HEADER_ROWS} / ${entry.rowEnd + HEADER_ROWS};--tt-slot-color:${entry.color}`}
                >
                  <span class="p-timetable__entry-time">
                    {entry.timeLabel}
                    {/* 画面では列の見出しでわかるが、読み上げ用に場所も持たせる */}
                    <span class="p-timetable__entry-slot">（{column.slot.name}）</span>
                  </span>
                  <span class="p-timetable__entry-title">{entry.title}</span>
                  <span class="p-timetable__entry-meta">
                    <span class="p-timetable__entry-type">{entry.type}</span>
                    {entry.theme && <span class="p-timetable__entry-theme">{entry.theme}</span>}
                    {entry.speaker && <span class="p-timetable__entry-speaker">{entry.speaker}</span>}
                  </span>
                </a>
              )),
            )}

            {/* 現在時刻ライン。開催当日に見ているときだけスクリプトが位置を入れて表示する */}
            <div class="p-timetable__now" id="js-timetable-now" hidden aria-hidden="true" {...nowData}>
              <span class="p-timetable__now-label" />
            </div>
          </div>
        </div>
      </>
    )
  }

  <p class="p-timetable__caption">
    {timetableConfig.startTime}-{timetableConfig.endTime}／時間・場所は変更になる場合があります。
  </p>
</div>

<script>
  // 現在時刻ライン。開催当日に、開催時間内に見ているときだけ出す。
  // 当日かどうかも位置も、閲覧者の端末の時計（ローカル時刻）で決める。
  const line = document.getElementById("js-timetable-now");

  if (line instanceof HTMLElement) {
    const label = line.querySelector(".p-timetable__now-label");

    /** "10:00" → 600（0時からの分数） */
    const toMinutes = (time: string): number => {
      const [hour = "0", minute = "0"] = time.split(":");
      return Number(hour) * 60 + Number(minute);
    };

    /** 12 → "12"、9 → "09" */
    const pad = (value: number): string => String(value).padStart(2, "0");

    const eventDate = line.dataset.date ?? "";
    const tableStart = toMinutes(line.dataset.start ?? "00:00");
    const tableEnd = toMinutes(line.dataset.end ?? "00:00");
    const step = Number(line.dataset.step ?? "5");
    const headerRows = Number(line.dataset.headerRows ?? "1");

    const update = (): void => {
      const now = new Date();
      const today = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
      const minutes = now.getHours() * 60 + now.getMinutes();

      // 開催当日の、開催時間内だけ
      if (today !== eventDate || minutes < tableStart || minutes > tableEnd) {
        line.hidden = true;
        return;
      }

      // 行は step 分刻み。端数は行の高さに対する割合として下にずらす
      const offset = minutes - tableStart;
      line.style.gridRow = String(Math.floor(offset / step) + 1 + headerRows);
      line.style.transform = `translateY(calc(var(--tt-row-height) * ${(offset % step) / step}))`;
      if (label) label.textContent = `${pad(now.getHours())}:${pad(now.getMinutes())} いまここ`;
      line.hidden = false;
    };

    update();
    window.setInterval(update, 30_000);
  }
</script>
